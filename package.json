{
  "name": "oh-brain",
  "version": "0.3.1",
  "description": "Oh — give your AI a past. The verbatim memory layer for AI coding: every Claude Code + Codex session becomes memory your agent can recall (yours to recall, your team's to ask, your week to see).",
  "type": "module",
  "license": "Elastic-2.0",
  "homepage": "https://oh-landing-mu.vercel.app",
  "keywords": [
    "ai",
    "memory",
    "claude-code",
    "codex",
    "mcp",
    "team",
    "context"
  ],
  "bin": {
    "oh": "dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "skills",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@supabase/supabase-js": "^2.45.0",
    "openai": "^4.70.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
